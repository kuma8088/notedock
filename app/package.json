{
  "name": "notedock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claudeアプリのブラウザパネルで動くMarkdownエディター。",
  "scripts": {
    "build": "node build.mjs",
    "compile": "sh scripts/compile.sh",
    "test": "node --test test/*.test.mjs",
    "test:tz": "for tz in UTC Asia/Tokyo America/Los_Angeles; do TZ=$tz node --test test/periodic.test.mjs test/calendar.test.mjs test/task-buckets.test.mjs || exit 1; done",
    "start": "node server/main.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
